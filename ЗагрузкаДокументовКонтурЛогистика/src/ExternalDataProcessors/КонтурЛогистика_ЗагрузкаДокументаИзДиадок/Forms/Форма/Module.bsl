#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)

	Если Не ЗначениеЗаполнено(BoxId)
		Или Не ЗначениеЗаполнено(MessageId)
		Или Не ЗначениеЗаполнено(EntityId) Тогда

		ПоказатьПредупреждение(, "Заполните BoxId, MessageId и EntityId.");
		Возврат;

	КонецЕсли;

	РезультатЗагрузки = ЗагрузитьДокументИзДиадокНаСервере(СокрЛП(BoxId), СокрЛП(MessageId), СокрЛП(EntityId));

	Если РезультатЗагрузки.Успешно Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = РезультатЗагрузки.ТекстРезультата;
		Сообщение.Сообщить();

	Иначе

		ПоказатьПредупреждение(, РезультатЗагрузки.ТекстОшибки);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлОбмена(Команда)

	Если Не ЗначениеЗаполнено(ФайлОбмена) Тогда
		ПоказатьПредупреждение(, "Файл обмена ещё не загружен.");
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(, ФайлОбмена);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗагрузитьДокументИзДиадокНаСервере(Знач BoxId, Знач MessageId, Знач EntityId)

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстРезультата", "");

	ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.ПустаяСсылка();
	РезультатТекст = "";

	Попытка

		СуществующийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageId, EntityId);
		Если ЗначениеЗаполнено(СуществующийФайл) Тогда

			Результат = РезультатПоСуществующемуФайлу(СуществующийФайл);
			ФайлОбмена = Результат.ФайлОбмена;
			РезультатТекст = Результат.ТекстРезультата;

			Возврат Результат;

		КонецЕсли;

		ПараметрыСервиса = КонтурЛогистика_API_Диадок.ЛогистикаПараметрыСервиса_Диадок(BoxId);
		Ядро = КонтурЛогистика_API_Диадок.Ядро();

		Document = Ядро.АПИ_GetDocument(ПараметрыСервиса, BoxId, MessageId, EntityId);

		ДокументНеНайден = ТипЗнч(Document) <> Тип("Структура");
		Если Не ДокументНеНайден Тогда
			ДокументНеНайден = Не Document.Свойство("FileName");
		КонецЕсли;
		Если Не ДокументНеНайден Тогда
			ДокументНеНайден = Не ЗначениеЗаполнено(Document.FileName);
		КонецЕсли;

		Если ДокументНеНайден Тогда

			Результат.ТекстОшибки = "Документ с указанными идентификаторами не найден в ящике " + BoxId + ".";
			Возврат Результат;

		КонецЕсли;

		ВерсияДокумента = ВерсияДокументаИзДанныхДиадок(Document);
		ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(
			Document.FileName,, ВерсияДокумента);
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка() Тогда

			Результат.ТекстОшибки = "Тип документа не поддерживается конфигурацией (имя файла: "
				+ Document.FileName + ").";
			Возврат Результат;

		КонецЕсли;

		ОшибкаВерсииФормата = ПроверитьВерсиюФорматаДокумента(ТипДокумента, ВерсияДокумента);
		Если ЗначениеЗаполнено(ОшибкаВерсииФормата) Тогда
			Результат.ТекстОшибки = ОшибкаВерсииФормата;
			Возврат Результат;
		КонецЕсли;

		ДвоичныеДанныеТитула = Ядро.АПИ_GetEntityContent(ПараметрыСервиса, BoxId, MessageId, EntityId);
		Если ДвоичныеДанныеТитула = Неопределено Тогда

			Результат.ТекстОшибки = "Не удалось получить содержимое документа " + EntityId
				+ " из сообщения " + MessageId + ".";
			Возврат Результат;

		КонецЕсли;

		FileNameБезxml = СтрЗаменить(Document.FileName, ".xml", "");
		GUID = Прав(СокрЛП(FileNameБезxml), 36);

		ТекстXML = ТекстXMLИзДвоичныхДанных(ДвоичныеДанныеТитула);

		Попытка
			XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстXML);
		Исключение
			Результат.ТекстОшибки = "Не удалось разобрать XML документа " + EntityId
				+ " (файл " + FileNameБезxml + "). Файл обмена не создан: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;

		ВерсияФормата = XDTO.ВерсФорм;
		ВерсияПрограммы = XDTO.ВерсПрог;

		СтороныОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.ОтправительИПолучательПоFileName(
			FileNameБезxml, ВерсияДокумента);

		ВеткаТитула = ВеткаТитулаИзДокументооборота(BoxId, MessageId, EntityId, ТипДокумента, Document);
		EntityIdПодписи = EntityIdПодписиИзВетки(ВеткаТитула);
		ДвоичныеДанныеПодписи = Неопределено;
		Если ЗначениеЗаполнено(EntityIdПодписи) Тогда
			ДвоичныеДанныеПодписи = Ядро.АПИ_GetEntityContent(
				ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
		КонецЕсли;

		ДатаВремяФормирования = Неопределено;
		Если Document.Свойство("CreationTimestampTicks") Тогда
			ДатаВремяФормирования = КонтурЛогистика_API_Диадок.Ticks_2_МСК(Document.CreationTimestampTicks);
		КонецЕсли;

		ФайлОбменаОбъект = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьЭлемент();
		ФайлОбменаОбъект.ВерсияФормата = ВерсияФормата;
		ФайлОбменаОбъект.ВерсияПрограммы = ВерсияПрограммы;
		ФайлОбменаОбъект.GUID = GUID;
		ФайлОбменаОбъект.ТекстXML = Новый ХранилищеЗначения(ТекстXML, Новый СжатиеДанных(9));
		ФайлОбменаОбъект.DocumentId = EntityId;
		ФайлОбменаОбъект.MessageID = MessageId;
		ФайлОбменаОбъект.ТипДокумента = ТипДокумента;
		ФайлОбменаОбъект.ИмяФайла = FileNameБезxml;
		ФайлОбменаОбъект.Отправитель = СтороныОбмена.Отправитель;
		ФайлОбменаОбъект.Получатель = СтороныОбмена.Получатель;

		Если ЗначениеЗаполнено(ДатаВремяФормирования) Тогда
			ФайлОбменаОбъект.ДатаВремяФормирования = ДатаВремяФормирования;
		КонецЕсли;

		ФайлОбменаОбъект.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен;
		ФайлОбменаОбъект.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок;

		ЗаполнитьСтатусПодписиВФайл(ФайлОбменаОбъект, Document);

		СтатусПроверкиСертификата = 0;
		Если ДвоичныеДанныеПодписи <> Неопределено Тогда
			ФайлОбменаОбъект.Подпись = Новый ХранилищеЗначения(ДвоичныеДанныеПодписи);
			ФайлОбменаОбъект.ПодписьЕсть = Истина;
			СтатусПроверкиСертификата = ЗаполнитьДанныеПодписанта(
				ФайлОбменаОбъект, BoxId, MessageId, EntityIdПодписи);
		КонецЕсли;

		ЗаполнитьРеквизитыМЧДВФайл(ФайлОбменаОбъект, ВеткаТитула, BoxId, MessageId);
		ЗаполнитьШаблонныеРеквизитыВФайл(ФайлОбменаОбъект, Document);

		Если Document.Свойство("PacketId") Тогда
			Если ЗначениеЗаполнено(Document.PacketId) Тогда
				ФайлОбменаОбъект.PacketId = Document.PacketId;
			КонецЕсли;
		КонецЕсли;

		Если Document.Свойство("DocumentInfo") Тогда
			DocumentInfoДляТеста = Document.DocumentInfo;
			Если ТипЗнч(DocumentInfoДляТеста) = Тип("Структура") Тогда
				Если DocumentInfoДляТеста.Свойство("LetterInfo") Тогда
					LetterInfo = DocumentInfoДляТеста.LetterInfo;
					Если ТипЗнч(LetterInfo) = Тип("Структура") Тогда
						Если LetterInfo.Свойство("IsTest") Тогда
							ФайлОбменаОбъект.ТестовыйДокумент = LetterInfo.IsTest;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		CustomDataМассив = Новый Массив;
		Если Document.Свойство("DocumentInfo") Тогда
			DocumentInfoДляCustomData = Document.DocumentInfo;
			Если ТипЗнч(DocumentInfoДляCustomData) = Тип("Структура") Тогда
				Если DocumentInfoДляCustomData.Свойство("CustomData") Тогда
					Если ТипЗнч(DocumentInfoДляCustomData.CustomData) = Тип("Массив") Тогда
						CustomDataМассив = DocumentInfoДляCustomData.CustomData;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ДатаСобытияМСК = ?(ЗначениеЗаполнено(ДатаВремяФормирования),
			ДатаВремяФормирования, КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК());
		КонтурЛогистика_ОбработкаДокументовСервер.СохранитьДанныеCustomDataВФайл(
			ФайлОбменаОбъект, Истина, CustomDataМассив, ДатаСобытияМСК, "");

		// Проверка дубля повторяется под блокировкой: параллельный вызов не должен создать второй файл обмена.
		КонкурентныйФайл = Неопределено;
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.КонтурЛогистика_ФайлыОбмена");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаДанных.Заблокировать();

			КонкурентныйФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageId, EntityId);
			Если Не ЗначениеЗаполнено(КонкурентныйФайл) Тогда
				ФайлОбменаОбъект.Записать();
			КонецЕсли;

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		Если ЗначениеЗаполнено(КонкурентныйФайл) Тогда

			Результат = РезультатПоСуществующемуФайлу(КонкурентныйФайл);
			ФайлОбмена = Результат.ФайлОбмена;
			РезультатТекст = Результат.ТекстРезультата;

			Возврат Результат;

		КонецЕсли;

		МассивФайлов = Новый Массив;
		МассивФайлов.Добавить(ФайлОбменаОбъект.Ссылка);
		КонтурЛогистика_ОбработкаДокументовСервер.СоздатьТитулыПоЗагруженнымФайламОбмена(МассивФайлов);

		ФайлСсылка = ФайлОбменаОбъект.Ссылка;
		ФайлОбмена = ФайлСсылка;

		Если ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) Тогда
			Результат.ТекстРезультата = "Документ загружен: " + Строка(ФайлСсылка.ГлавныйДокумент)
				+ " (файл обмена " + Строка(ФайлСсылка) + ").";
		Иначе
			Результат.ТекстРезультата = "Файл обмена создан (" + Строка(ФайлСсылка)
				+ "), но прикладной документ не создан. Проверьте, загружен ли ранее титул 1 документа.";
		КонецЕсли;

		Если ДвоичныеДанныеПодписи = Неопределено Тогда
			Результат.ТекстРезультата = Результат.ТекстРезультата
				+ " Подпись в Диадоке не найдена, файл загружен без подписи.";
		ИначеЕсли Не ФайлСсылка.ПодписьВерна Тогда
			ЗафиксироватьОшибкуПодписи(ФайлСсылка, СтатусПроверкиСертификата);
			Результат.ТекстРезультата = Результат.ТекстРезультата
				+ " Подпись не прошла проверку, установлен статус ошибки титула.";
		КонецЕсли;

		РезультатТекст = Результат.ТекстРезультата;
		Результат.Успешно = Истина;

	Исключение

		Результат.ТекстОшибки = "Не удалось загрузить документ: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

		Попытка
			ФайлСсылка = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageId, EntityId);
			Если ЗначениеЗаполнено(ФайлСсылка) Тогда
				ФайлОбмена = ФайлСсылка;
			КонецЕсли;
		Исключение
			ФайлСсылка = Неопределено;
		КонецПопытки;

		ЗаписьЖурналаРегистрации(
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);

	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ВерсияДокументаИзДанныхДиадок(Document)

	Если ТипЗнч(Document) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не Document.Свойство("DocumentInfo") Тогда
		Возврат Неопределено;
	КонецЕсли;

	DocumentInfo = Document.DocumentInfo;
	Если ТипЗнч(DocumentInfo) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не DocumentInfo.Свойство("FullVersion") Тогда
		Возврат Неопределено;
	КонецЕсли;

	FullVersion = DocumentInfo.FullVersion;
	Если ТипЗнч(FullVersion) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не FullVersion.Свойство("Version") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат FullVersion.Version;

КонецФункции

&НаСервере
Функция ДокументооборотПоДокументу(Знач BoxId, Знач MessageId, Знач EntityId)

	СписокДокументов = Новый Массив;
	ДокументДляЗапроса = Новый Структура("MessageId, EntityId", MessageId, EntityId);
	СписокДокументов.Добавить(ДокументДляЗапроса);

	// Контент документа не нужен: требуются только метаданные подписи титула.
	Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetDocflows(BoxId, СписокДокументов, Ложь);

	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не Ответ.Свойство("Docflows") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Docflows = Ответ.Docflows;
	Если ТипЗнч(Docflows) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Docflows.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭлементДокументооборота = Docflows[0];
	Если ТипЗнч(ЭлементДокументооборота) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭлементДокументооборота.Свойство("Docflow") Тогда
		Если ТипЗнч(ЭлементДокументооборота.Docflow) = Тип("Структура") Тогда
			Возврат ЭлементДокументооборота.Docflow;
		КонецЕсли;
	КонецЕсли;

	Возврат ЭлементДокументооборота;

КонецФункции

&НаСервере
Функция ВеткаТитулаИзДокументооборота(Знач BoxId, Знач MessageId, Знач EntityId, Знач ТипДокумента, Знач Document)

	Docflow = ДокументооборотПоДокументу(BoxId, MessageId, EntityId);
	Если Docflow = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭтоПересланный = ЭтоПересланныйДокумент(Document);

	// Ветка титула определяется типом титула так же, как в КонтурЛогистика_API_Диадок.РеквизитыДоверенностиВФайл.
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоОтветныйТитул(ТипДокумента)
		И Не ЭтоПересланный Тогда

		Если Docflow.Свойство("RecipientResponse") Тогда
			Возврат Docflow.RecipientResponse;
		КонецЕсли;

		Возврат Неопределено;

	КонецЕсли;

	Если Не Docflow.Свойство("SenderTitle") Тогда
		Возврат Неопределено;
	КонецЕсли;

	SenderTitle = Docflow.SenderTitle;
	Если ТипЗнч(SenderTitle) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не SenderTitle.Свойство("Attachment") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат SenderTitle.Attachment;

КонецФункции

&НаСервере
Функция ЭтоПересланныйДокумент(Знач Document)

	Если ТипЗнч(Document) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не Document.Свойство("DocumentInfo") Тогда
		Возврат Ложь;
	КонецЕсли;

	DocumentInfo = Document.DocumentInfo;
	Если ТипЗнч(DocumentInfo) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не DocumentInfo.Свойство("FullVersion") Тогда
		Возврат Ложь;
	КонецЕсли;

	FullVersion = DocumentInfo.FullVersion;
	Если ТипЗнч(FullVersion) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не FullVersion.Свойство("Function") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат FullVersion.Function = "fwd";

КонецФункции

&НаСервере
Функция EntityIdПодписиИзВетки(Знач ВеткаТитула)

	Если ТипЗнч(ВеткаТитула) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ВеткаТитула.Свойство("Signature") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Подпись = ВеткаТитула.Signature;
	Если ТипЗнч(Подпись) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Приоритет кадестированной подписи над cms, как в КонтурЛогистика_API_Диадок.ПолучитьEntityIdПодписи.
	Если Подпись.Свойство("CadesT") Тогда
		Если ТипЗнч(Подпись.CadesT) = Тип("Структура") Тогда
			Если Подпись.CadesT.Свойство("EntityId") Тогда
				Если ЗначениеЗаполнено(Подпись.CadesT.EntityId) Тогда
					Возврат Подпись.CadesT.EntityId;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Подпись.Свойство("Cms") Тогда
		Если ТипЗнч(Подпись.Cms) = Тип("Структура") Тогда
			Если Подпись.Cms.Свойство("EntityId") Тогда
				Возврат Подпись.Cms.EntityId;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция РезультатПоСуществующемуФайлу(Знач ФайлСсылка)

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстРезультата", "");
	Результат.Вставить("ФайлОбмена", ФайлСсылка);

	Если Не ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) Тогда

		// Прошлый вызов мог упасть до создания документа — доводим штатную обработку до конца.
		Попытка
			МассивФайлов = Новый Массив;
			МассивФайлов.Добавить(ФайлСсылка);
			КонтурЛогистика_ОбработкаДокументовСервер.СоздатьТитулыПоЗагруженнымФайламОбмена(МассивФайлов);
		Исключение
			Результат.ТекстОшибки = "Файл обмена уже существует, но создать документ не удалось: "
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Результат.Успешно = Истина;

	Если ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) Тогда
		Результат.ТекстРезультата = "Документ уже загружен: " + Строка(ФайлСсылка.ГлавныйДокумент)
			+ " (файл обмена " + Строка(ФайлСсылка) + ").";
	Иначе
		Результат.ТекстРезультата = "Файл обмена " + Строка(ФайлСсылка)
			+ " уже существует, но прикладной документ не создан. Проверьте, загружен ли ранее титул 1 документа.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверитьВерсиюФорматаДокумента(Знач ТипДокумента, Знач ВерсияДокумента)

	Если Не ЗначениеЗаполнено(ВерсияДокумента) Тогда
		Возврат "";
	КонецЕсли;

	ТекущаяВерсия = Неопределено;

	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипДокумента) Тогда
		ТекущаяВерсия = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.ТекущаяВерсияСТД();
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ТипДокумента) Тогда
		ТекущаяВерсия = Документы.КонтурЛогистика_СкладскаяРасписка.ТекущаяВерсияСТД();
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипДокумента) Тогда
		ТекущаяВерсия = Документы.КонтурЛогистика_ПЭ_Титул1.ТекущаяВерсияСТД();
	Иначе
		Возврат "";
	КонецЕсли;

	Если ВерсияДокумента <> ТекущаяВерсия Тогда
		Возврат "Версия формата документа (" + ВерсияДокумента
			+ ") не поддерживается конфигурацией, поддерживается версия " + ТекущаяВерсия + ".";
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Функция ТекстXMLИзДвоичныхДанных(Знач ДвоичныеДанные)

	// По стандарту XML без объявления кодировки — UTF-8, поэтому первый проход всегда UTF-8.
	Текст = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтрокуИзДвоичныхДанныхЛок(ДвоичныеДанные, "utf-8");

	Если СтрНайти(Лев(Текст, 20), "<") = 0 Тогда
		// UTF-16 читается как utf-8 мусором — пробуем второй вариант.
		ТекстUTF16 = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтрокуИзДвоичныхДанныхЛок(ДвоичныеДанные, "utf-16");
		Если СтрНайти(Лев(ТекстUTF16, 20), "<") > 0 Тогда
			Возврат ТекстUTF16;
		КонецЕсли;
	КонецЕсли;

	КодировкаФайла = КодировкаИзПрологаXML(Текст);
	Если ЗначениеЗаполнено(КодировкаФайла) И НРег(КодировкаФайла) <> "utf-8" Тогда
		Текст = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтрокуИзДвоичныхДанныхЛок(ДвоичныеДанные, КодировкаФайла);
	КонецЕсли;

	Возврат Текст;

КонецФункции

&НаСервере
Функция КодировкаИзПрологаXML(Знач ТекстXML)

	// Кодировка объявлена в прологе ASCII-символами: <?xml version="1.0" encoding="windows-1251"?>
	Пролог = Лев(ТекстXML, 500);
	Позиция = СтрНайти(НРег(Пролог), "encoding");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Пролог = Сред(Пролог, Позиция, 100);
	ПозицияРавно = СтрНайти(Пролог, "=");
	Если ПозицияРавно = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = СокрЛП(Сред(Пролог, ПозицияРавно + 1));
	Кавычка = Лев(Остаток, 1);
	Если Кавычка <> """" И Кавычка <> "'" Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Остаток, 2);
	ПозицияКавычки = СтрНайти(Остаток, Кавычка);
	Если ПозицияКавычки = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(СокрЛП(Лев(Остаток, ПозицияКавычки - 1)));

КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыМЧДВФайл(ФайлОбменаОбъект, Знач ВеткаТитула, Знач BoxId, Знач MessageId)

	Если ТипЗнч(ВеткаТитула) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Не ВеткаТитула.Свойство("Signature") Тогда
		Возврат;
	КонецЕсли;

	Подпись = ВеткаТитула.Signature;
	Если ТипЗнч(Подпись) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Подпись.Свойство("PowerOfAttorney") Тогда

		ДанныеДоверенности = Подпись.PowerOfAttorney;
		Если ТипЗнч(ДанныеДоверенности) = Тип("Структура") Тогда

			Если ДанныеДоверенности.Свойство("FullId") Тогда
				FullId = ДанныеДоверенности.FullId;
				Если ТипЗнч(FullId) = Тип("Структура") Тогда
					Если FullId.Свойство("RegistrationNumber") Тогда
						ФайлОбменаОбъект.ИдентификаторМЧД = FullId.RegistrationNumber;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			ОшибкиМЧД = ЗаполнитьСтатусПроверкиМЧДВФайл(ФайлОбменаОбъект, ДанныеДоверенности);

			// Загружаем МЧД в справочник и актуализируем её статус, как в КонтурЛогистика_API_Диадок.РеквизитыДоверенностиВФайл.
			ЗагрузитьВходящуюМЧД(BoxId, MessageId, ДанныеДоверенности);
			ОбновитьСтатусМЧД(ДанныеДоверенности, ОшибкиМЧД);

		КонецЕсли;

	КонецЕсли;

	Если Подпись.Свойство("PowerOfAttorneyAttachmentStatus") Тогда

		СтатусПриложенности = Подпись.PowerOfAttorneyAttachmentStatus;
		Если ТипЗнч(СтатусПриложенности) = Тип("Структура") Тогда
			Если СтатусПриложенности.Свойство("StatusName") Тогда
				ФайлОбменаОбъект.СтатусПриложенностиМЧД = СтатусПриложенности.StatusName;
			КонецЕсли;
			Если СтатусПриложенности.Свойство("Comment") Тогда
				ФайлОбменаОбъект.СтатусПриложенностиМЧДОписание = СтатусПриложенности.Comment;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьСтатусПроверкиМЧДВФайл(ФайлОбменаОбъект, Знач ДанныеДоверенности)

	Если Не ДанныеДоверенности.Свойство("Status") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Статус = ДанныеДоверенности.Status;
	Если ТипЗнч(Статус) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Статус.Свойство("StatusNamedId") Тогда
		ФайлОбменаОбъект.СтатусПроверкиМЧДПоТитулу = Статус.StatusNamedId;
	КонецЕсли;

	Ошибки = Неопределено;

	Если Статус.Свойство("ValidationProtocol") Тогда
		Попытка
			Ошибки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибкиИзПротоколаВалидации(Статус.ValidationProtocol);
		Исключение
			Ошибки = Неопределено;
		КонецПопытки;
	ИначеЕсли Статус.Свойство("Errors") Тогда
		Если ТипЗнч(Статус.Errors) = Тип("Массив") Тогда
			Ошибки = Статус.Errors;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ошибки) Тогда
		ФайлОбменаОбъект.ОшибкиПроверкиМЧД = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(Ошибки);
	КонецЕсли;

	Возврат Ошибки;

КонецФункции

&НаСервере
Процедура ЗагрузитьВходящуюМЧД(Знач BoxId, Знач MessageId, Знач ДанныеДоверенности)

	// Как в КонтурЛогистика_API_Диадок.ЗагрузитьВходящуюМЧД: содержимое доверенности не должно ломать загрузку титула.
	Попытка

		Если Не ДанныеДоверенности.Свойство("Entity") Тогда
			Возврат;
		КонецЕсли;

		EntityДоверенности = ДанныеДоверенности.Entity;
		Если ТипЗнч(EntityДоверенности) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;

		Если Не EntityДоверенности.Свойство("EntityId") Тогда
			Возврат;
		КонецЕсли;

		EntityIdДоверенности = EntityДоверенности.EntityId;
		Если Не ЗначениеЗаполнено(EntityIdДоверенности) Тогда
			Возврат;
		КонецЕсли;

		СпособОтправки = "";
		Если ДанныеДоверенности.Свойство("SendingType") Тогда
			СпособОтправки = ДанныеДоверенности.SendingType;
		КонецЕсли;

		Ответ = Неопределено;
		Если СпособОтправки = "File" Тогда
			Попытка
				Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetPowerOfAttorneyContent(BoxId, MessageId, EntityIdДоверенности);
			Исключение
				Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetPowerOfAttorneyInfo(BoxId, MessageId, EntityIdДоверенности);
			КонецПопытки;
		Иначе
			Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetPowerOfAttorneyInfo(BoxId, MessageId, EntityIdДоверенности);
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Ответ) Тогда
			Возврат;
		КонецЕсли;

		Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;

		ЗагрузитьМЧДИзОтветаДиадок(Ответ);

	Исключение
		ЗаписьЖурналаРегистрации(
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Загрузка документа из Диадок: не удалось загрузить входящую МЧД. "
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМЧДИзОтветаДиадок(Знач Ответ)

	Если Ответ.Свойство("Content") И Ответ.Свойство("Signature") Тогда
		Если ЗначениеЗаполнено(Ответ.Content) И ЗначениеЗаполнено(Ответ.Signature) Тогда
			КонтурЛогистика_МашиночитаемыеДовернностиСервер.ЗагрузитьМЧДИзФайла(
				Base64Значение(Ответ.Content), Base64Значение(Ответ.Signature));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если Ответ.Свойство("FullId") Тогда
		КонтурЛогистика_МашиночитаемыеДовернностиСервер.ЗагрузитьPowerOfAttorney(Ответ);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусМЧД(Знач ДанныеДоверенности, Знач ОшибкиМЧД)

	Если Не ДанныеДоверенности.Свойство("Status") Тогда
		Возврат;
	КонецЕсли;

	Если Не ДанныеДоверенности.Свойство("FullId") Тогда
		Возврат;
	КонецЕсли;

	FullId = ДанныеДоверенности.FullId;
	Если ТипЗнч(FullId) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Не FullId.Свойство("RegistrationNumber") Тогда
		Возврат;
	КонецЕсли;

	МЧД = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", FullId.RegistrationNumber);
	Если МЧД.Пустая() Тогда
		Возврат;
	КонецЕсли;

	// Чужие (не наши) МЧД не обновляем, как в КонтурЛогистика_API_Диадок.ОбновитьСтатусМЧД.
	Если МЧД.Наша Тогда
		Возврат;
	КонецЕсли;

	Статус = ДанныеДоверенности.Status;
	Если ТипЗнч(Статус) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ТребуетсяЗаписатьМЧД = Ложь;
	МЧДОбъект = МЧД.ПолучитьОбъект();

	Если Статус.Свойство("StatusNamedId") Тогда
		Если МЧДОбъект.СтатусПроверки <> Статус.StatusNamedId Тогда
			МЧДОбъект.СтатусПроверки = Статус.StatusNamedId;
			ТребуетсяЗаписатьМЧД = Истина;
		КонецЕсли;
	КонецЕсли;

	Если Статус.Свойство("StatusText") Тогда
		Если МЧДОбъект.ТекстСтатусаПроверки <> Статус.StatusText Тогда
			МЧДОбъект.ТекстСтатусаПроверки = Статус.StatusText;
			ТребуетсяЗаписатьМЧД = Истина;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОшибкиМЧД) Тогда
		ОшибкиМЧДСтрока = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(ОшибкиМЧД);
		Если МЧДОбъект.ОшибкиПроверки <> ОшибкиМЧДСтрока Тогда
			МЧДОбъект.ОшибкиПроверки = ОшибкиМЧДСтрока;
			ТребуетсяЗаписатьМЧД = Истина;
		КонецЕсли;
	КонецЕсли;

	Если ТребуетсяЗаписатьМЧД Тогда
		МЧДОбъект.ДатаПроверки = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
		МЧДОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьШаблонныеРеквизитыВФайл(ФайлОбменаОбъект, Знач Document)

	Если ТипЗнч(Document) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Не Document.Свойство("Origin") Тогда
		Возврат;
	КонецЕсли;

	Origin = Document.Origin;
	Если ТипЗнч(Origin) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Не Origin.Свойство("MessageType") Тогда
		Возврат;
	КонецЕсли;

	Если Origin.MessageType <> "Template" Тогда
		Возврат;
	КонецЕсли;

	Если Origin.Свойство("MessageId") Тогда
		ФайлОбменаОбъект.ШаблонОснование = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(
			Origin.MessageId, ФайлОбменаОбъект.DocumentId);
	КонецЕсли;

	Если Document.Свойство("CounteragentBoxId") Тогда
		Если ЗначениеЗаполнено(Document.CounteragentBoxId) Тогда
			BoxIdОтправителяШаблона = КонтурЛогистика_API_Диадок.АдресЯщикаВИдентификатор(Document.CounteragentBoxId);
			Если ЗначениеЗаполнено(BoxIdОтправителяШаблона) Тогда
				ФайлОбменаОбъект.ОтправительШаблона =
					Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьОрганиациюДДПоId(BoxIdОтправителяШаблона);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Document.Свойство("DocumentInfo") Тогда
		DocumentInfo = Document.DocumentInfo;
		Если ТипЗнч(DocumentInfo) = Тип("Структура") Тогда
			Если DocumentInfo.Свойство("EditingSettingId") Тогда
				ФайлОбменаОбъект.EditingSettingId = СокрЛП(DocumentInfo.EditingSettingId);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьОшибкуПодписи(Знач ФайлСсылка, Знач СтатусПроверкиСертификата)

	Если Не ЗначениеЗаполнено(ФайлСсылка) Тогда
		Возврат;
	КонецЕсли;

	ДокументСсылка = ФайлСсылка.ГлавныйДокумент;
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	// Записи об ошибках не удаляем: перекрываем новой записью с Период = МаксимумПериод + 1.
	НаборЗаписей = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументСсылка);
	НаборЗаписей.Прочитать();

	МаксимумПериод = '00010101';
	СтатусПодписи = Неопределено;
	Для Каждого ЗаписьРегистра Из НаборЗаписей Цикл
		Если ЗаписьРегистра.Период > МаксимумПериод Тогда
			МаксимумПериод = ЗаписьРегистра.Период;
			СтатусПодписи = ЗаписьРегистра.СтатусПодписи;
		КонецЕсли;
	КонецЦикла;

	МенеджерЗаписи = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = МаксимумПериод + 1;
	МенеджерЗаписи.Документ = ДокументСсылка;
	МенеджерЗаписи.Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка;
	Если СтатусПодписи <> Неопределено Тогда
		МенеджерЗаписи.СтатусПодписи = СтатусПодписи;
	КонецЕсли;
	МенеджерЗаписи.ТипОшибки = Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи;

	Если СтатусПроверкиСертификата = 0 Тогда
		МенеджерЗаписи.КодОшибки = "";
		МенеджерЗаписи.ОписаниеОшибки = "Подпись не верна";
		МенеджерЗаписи.ПодробноеОписаниеОшибки = "Подпись не верна";
	Иначе
		ОписаниеОшибки = КонтурЛогистика_КриптографияСервер.ПолучитьСтатусПроверкиСертификатаПоКоду(СтатусПроверкиСертификата);
		МенеджерЗаписи.КодОшибки = Лев(Строка(СтатусПроверкиСертификата), 50);
		МенеджерЗаписи.ОписаниеОшибки = "Ошибка сертификата";
		МенеджерЗаписи.ПодробноеОписаниеОшибки = ОписаниеОшибки;
	КонецЕсли;

	МенеджерЗаписи.Записать();

	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	ФайлОбъект.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.ОшибкаОтправки;
	ФайлОбъект.Записать();

КонецПроцедуры

&НаСервере
Функция СтатусПроверкиСертификатаИзДанных(SignatureInfo)

	Если ТипЗнч(SignatureInfo) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Если Не SignatureInfo.Свойство("SignatureVerificationResult") Тогда
		Возврат 0;
	КонецЕсли;

	РезультатПроверки = SignatureInfo.SignatureVerificationResult;
	Если ТипЗнч(РезультатПроверки) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Если Не РезультатПроверки.Свойство("CertificateStatus") Тогда
		Возврат 0;
	КонецЕсли;

	CertificateStatus = РезультатПроверки.CertificateStatus;
	Если ТипЗнч(CertificateStatus) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Если Не CertificateStatus.Свойство("CertificateChain") Тогда
		Возврат 0;
	КонецЕсли;

	Цепочка = CertificateStatus.CertificateChain;
	Если ТипЗнч(Цепочка) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;

	Если Цепочка.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ПервыйСертификат = Цепочка[0];
	Если ТипЗнч(ПервыйСертификат) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Если Не ПервыйСертификат.Свойство("CertificateChainStatusFlags") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ПервыйСертификат.CertificateChainStatusFlags;

КонецФункции

&НаСервере
Процедура ЗаполнитьСтатусПодписиВФайл(ФайлОбменаОбъект, Document)

	Если Не Document.Свойство("SenderSignatureStatus") Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Document.SenderSignatureStatus) Тогда
		Возврат;
	КонецЕсли;

	ФайлОбменаОбъект.ПодписьВерна = Document.SenderSignatureStatus = "SenderSignatureCheckedAndValid";

	Попытка
		ФайлОбменаОбъект.СтатусПодписи =
			Перечисления.КонтурЛогистика_СтатусыПодписи[Document.SenderSignatureStatus];
	Исключение
		ФайлОбменаОбъект.СтатусПодписи = Перечисления.КонтурЛогистика_СтатусыПодписи.ПустаяСсылка();
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеПодписанта(ФайлОбменаОбъект, Знач BoxId, Знач MessageId, Знач EntityIdПодписи)

	SignatureInfo = Неопределено;
	Попытка
		SignatureInfo = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetSignatureInfo(BoxId, MessageId, EntityIdПодписи);
	Исключение
		SignatureInfo = Неопределено;
	КонецПопытки;

	Если ТипЗнч(SignatureInfo) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Подписант = ?(SignatureInfo.Свойство("Surname"), SignatureInfo.Surname + " ", "")
		+ ?(SignatureInfo.Свойство("FirstName"), SignatureInfo.FirstName, "");

	Тип = "";
	Если SignatureInfo.Свойство("CertificateSubjectType") Тогда
		Если SignatureInfo.CertificateSubjectType = "IndividualEntity" Тогда
			Тип = "ИП";
		ИначеЕсли SignatureInfo.CertificateSubjectType = "PhysicalPerson" Тогда
			Тип = "Физ лицо";
		ИначеЕсли SignatureInfo.CertificateSubjectType = "LegalEntity" Тогда
			Если SignatureInfo.Свойство("OrgName") Тогда
				Если ЗначениеЗаполнено(SignatureInfo.OrgName) Тогда
					Тип = SignatureInfo.OrgName;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ФайлОбменаОбъект.КомуВыданСертификат = СокрЛП(Подписант)
		+ ?(ЗначениеЗаполнено(Тип), ", " + Тип, "");

	Если SignatureInfo.Свойство("Thumbprint") Тогда
		ФайлОбменаОбъект.Отпечаток = SignatureInfo.Thumbprint;
	КонецЕсли;

	ЗаполнитьСертификатПодписанта(ФайлОбменаОбъект, SignatureInfo);

	СтатусПроверкиСертификата = СтатусПроверкиСертификатаИзДанных(SignatureInfo);
	Если СтатусПроверкиСертификата <> 0 Тогда
		ФайлОбменаОбъект.СтатусПроверкиСертификата = СтатусПроверкиСертификата;
	КонецЕсли;

	Возврат СтатусПроверкиСертификата;

КонецФункции

&НаСервере
Процедура ЗаполнитьСертификатПодписанта(ФайлОбменаОбъект, Знач SignatureInfo)

	// DER-сертификат берем из цепочки проверки подписи, как в КонтурЛогистика_API_Диадок.ЗаписатьДанныеПодписантаВФайл.
	Если Не SignatureInfo.Свойство("SignatureVerificationResult") Тогда
		Возврат;
	КонецЕсли;

	РезультатПроверки = SignatureInfo.SignatureVerificationResult;
	Если ТипЗнч(РезультатПроверки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Не РезультатПроверки.Свойство("CertificateStatus") Тогда
		Возврат;
	КонецЕсли;

	CertificateStatus = РезультатПроверки.CertificateStatus;
	Если ТипЗнч(CertificateStatus) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Не CertificateStatus.Свойство("CertificateChain") Тогда
		Возврат;
	КонецЕсли;

	Цепочка = CertificateStatus.CertificateChain;
	Если ТипЗнч(Цепочка) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Если Цепочка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПервыйСертификат = Цепочка[0];
	Если ТипЗнч(ПервыйСертификат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если Не ПервыйСертификат.Свойство("DerCertificate") Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПервыйСертификат.DerCertificate) Тогда
		Возврат;
	КонецЕсли;

	ФайлОбменаОбъект.Сертификат = Новый ХранилищеЗначения(Base64Значение(ПервыйСертификат.DerCertificate));

КонецПроцедуры

#КонецОбласти
